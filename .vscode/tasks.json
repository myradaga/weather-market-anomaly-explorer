{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "pytest", "-q"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Start Streamlit",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "streamlit", "run", "app/streamlit_app.py"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Docker: build",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "build"],
      "problemMatcher": []
    },
    {
      "label": "Docker: start",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "up", "-d"],
      "problemMatcher": []
    }
  ]
}
